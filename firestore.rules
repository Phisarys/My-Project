rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // Each person can read and write only their own record.
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Partner sharing. shares/{uid} holds only what partners may see: a display name and
    // the daily ring percentages for the last few days. viewers lists the partners (max 5).
    match /shares/{uid} {
      function shape(d) {
        return d.keys().hasOnly(['name', 'days', 'updated', 'viewers', 'via'])
          && d.name is string && d.name.size() <= 40
          && d.days is map && d.days.size() <= 8
          && d.viewers is list && d.viewers.size() <= 5
          && !(uid in d.viewers);
      }
      function invite() {
        return get(/databases/$(database)/documents/invites/$(request.resource.data.via)).data;
      }
      // A partner joins with a valid invite code from the owner: they may add only themselves.
      function joining() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers', 'via'])
          && !(request.auth.uid in resource.data.viewers)
          && request.resource.data.viewers == resource.data.viewers.concat([request.auth.uid])
          && request.resource.data.viewers.size() <= 5
          && request.resource.data.via is string
          && exists(/databases/$(database)/documents/invites/$(request.resource.data.via))
          && invite().from == uid
          && invite().expires > request.time.toMillis()
          // The invite must be deleted in the same write, so each code works only once.
          && !existsAfter(/databases/$(database)/documents/invites/$(request.resource.data.via));
      }
      // A partner may always take themselves off the list.
      function leaving() {
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers'])
          && request.auth.uid in resource.data.viewers
          && request.resource.data.viewers == resource.data.viewers.removeAll([request.auth.uid]);
      }
      allow read: if signedIn() && (request.auth.uid == uid || request.auth.uid in resource.data.viewers);
      allow create: if signedIn() && request.auth.uid == uid && shape(request.resource.data);
      allow update: if signedIn() && (
        (request.auth.uid == uid && shape(request.resource.data)) || joining() || leaving());
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Invite codes: 8 characters, one use, valid for up to 7 days. Knowing the code is the permission.
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.size() == 8
        && request.resource.data.keys().hasOnly(['from', 'name', 'expires'])
        && request.resource.data.from == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 40
        && request.resource.data.expires is int
        && request.resource.data.expires <= request.time.toMillis() + 7 * 24 * 60 * 60 * 1000 + 60000;
      // The person who made the code can withdraw it; a partner can use it up only while joining with it.
      allow delete: if signedIn() && (resource.data.from == request.auth.uid
        || (getAfter(/databases/$(database)/documents/shares/$(resource.data.from)).data.via == code
            && request.auth.uid in getAfter(/databases/$(database)/documents/shares/$(resource.data.from)).data.viewers));
    }
  }
}
